# Environment Variables — Production Deployment
# Fill in all required values. The installer generates this file from .env.example
# and patches secrets from the Legisell provisioning API.
# Generate JWT secrets: openssl rand -hex 32

# PostgreSQL
POSTGRES_USER=pos_user
POSTGRES_PASSWORD=pos_secure_password_change_me
POSTGRES_DB=pos_db
POSTGRES_SERVER=pos-database

# Redis
REDIS_HOST=pos-redis
# Replaced by provision.py on first deployment
REDIS_PASSWORD=change_me

# JWT Secrets — must differ from each other
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-different-refresh-secret-change-in-production

# Public host port for the frontend container
POS_PUBLIC_PORT=80

# Timezone for every container. Drives log timestamps, receipt times and the
# business-day boundary. The installer overwrites this with the host's own
# timezone; the value here is only the fallback for a hand-rolled install.
# Without it the containers run in UTC while the restaurant works local time.
TZ=Europe/Berlin

# -----------------------------------------------------------------------------
# Configured in-app, NOT here (stored in the database):
#   • Receipt printer (type, USB device / network IP)  → Settings ▸ Printer
#   • QR payment TTL                                    → Settings ▸ Payment
#   • Card/Terminal & QR provider credentials           → Settings ▸ Payment
#   • Timezone, admin login (ID 0001, 6-digit PIN, email) → first-run Setup wizard
# These are deliberately absent from this file.
# -----------------------------------------------------------------------------

# =============================================================================
# Production Deployment (docker-compose.prod.yml only)
# =============================================================================
# Container images pulled from GHCR — set the exact tag per release (e.g. 0.1.0).
# The installer prefills these from manifest.json; press Enter to accept.
#
# These stay TAG-pinned. The updater never writes a @sha256 digest here: it
# resolves the repository from this file and the version from manifest.json,
# pulls the image content-addressed by digest, and then tags it locally to the
# tag below. Point a value at a private mirror and updates follow it, no CI
# change needed. Each service is versioned independently.
IMAGE_BACKEND=ghcr.io/<org>/pos-backend:0.1.0
IMAGE_FRONTEND=ghcr.io/<org>/pos-frontend:0.1.0
IMAGE_IMAGE_SERVICE=ghcr.io/<org>/pos-image-service:0.1.0
IMAGE_UPDATER=ghcr.io/<org>/pos-updater:0.1.0
IMAGE_BACKUP=ghcr.io/<org>/pos-backup:0.1.0

# =============================================================================
# Updater Sidecar
# =============================================================================
# Docker Compose Projektname (muss mit dem laufenden Stack übereinstimmen).
# Default belassen — nur ändern, wenn mehrere POS-Instanzen auf demselben Host
# laufen und eindeutige Stack-Namen brauchen (Multi-Standort-Hosting).
COMPOSE_PROJECT_NAME=point-of-sale-prod

# Öffentliches Deployment-Repo. Der Installer liest daraus manifest.json, um die
# IMAGE_*-Felder vorzubefüllen. Kein Token nötig.
# Format: <owner>/<repo>
DEPLOYMENT_REPO=JahongirHabibov/pos-deployment

# Update-Kanal: stable (empfohlen) oder beta
UPDATE_CHANNEL=stable

# Absolute path to the deployment directory ON THE HOST (not the container path).
# Required for Phase 7 updater self-update and for bind-mounts in
# docker-compose.prod.yml that use ${HOST_COMPOSE_PROJECT_DIR}.
# Example: /root/pos-deployment
HOST_COMPOSE_PROJECT_DIR=/path/to/pos-deployment

# Absolute Linux path to the Docker auth JSON file (written by installer after GHCR login)
POS_DOCKER_AUTH_FILE=

# =============================================================================
# Backup Sidecar
# =============================================================================
# The backup service has no published port and no separate login. It is managed
# entirely from within the POS admin UI (Settings ▸ Backup), gated by the
# `system.backup` permission. No BACKUP_UI_* credentials are needed.
#
# Only remote off-site storage credentials (optional) live here, because they
# must never be persisted in the sidecar's state file.

# Remote backup: SFTP (optional)
# BACKUP_SFTP_HOST=mein-nas.example.com
# BACKUP_SFTP_PORT=22
# BACKUP_SFTP_USER=backup
# BACKUP_SFTP_PASSWORD=geheimwort
# BACKUP_SFTP_PATH=/mnt/backups/pos

# Remote backup: S3-compatible storage (optional)
# BACKUP_S3_ENDPOINT=https://s3.example.com
# BACKUP_S3_BUCKET=pos-backups
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
# BACKUP_S3_PREFIX=pos-backups

# =============================================================================
# Image Defaults — add ONLY if you need to override the baked-in value
# These are set by the production image and do not need to be configured.
# =============================================================================
# COOKIE_SECURE=auto              # auto | true | false  (auto = derive from X-Forwarded-Proto)
# LOG_LEVEL=INFO                  # INFO | WARNING | ERROR | DEBUG
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# REDIS_DB=0
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=240 # Image default: 240 (4 h; clients refresh silently)
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800
# HEALTH_CHECK_TIMEOUT=5
# SHUTDOWN_TIMEOUT=30
# CLEANUP_CHECK_INTERVAL=3600     # background image-cleanup safety-net interval (s)
# POS_IMAGE_FILTER=pos-

# =============================================================================
# Updater — per-service updates, decoupled download & disk hygiene (optional)
# The updater tracks each service image independently and pulls only the images
# that actually changed. Downloads are decoupled from apply: images are pulled
# in the background (with retry/backoff) while the restaurant keeps working, and
# only once every image is present AND verified does "Jetzt aktualisieren"
# become available. Applying is additionally blocked while a register session is
# open or orders are active. Defaults are sensible — override only if needed.
# =============================================================================
# Rolling multi-service manifest (schema:2 or :3). CI keeps this file current;
# the updater reads it to learn each service's latest version and digest, and
# the installer reads it to prefill the IMAGE_* fields. Stable raw URL:
# WEBSITE_UPDATE_METADATA_URL=https://raw.githubusercontent.com/JahongirHabibov/pos-deployment/main/manifest.json
# ONPREM_UPDATE_METADATA_URL=      # optional on-prem mirror (checked first)
# UPDATE_CHANNEL=stable

# Pull images automatically once a check finds an update (apply always stays
# manual — nothing is ever installed without an admin clicking).
# UPDATE_AUTO_DOWNLOAD=true
# UPDATE_CHECK_INTERVAL_SECONDS=21600   # 6 h

# Pre-apply database snapshot: taken via the backup sidecar and awaited before
# any container is recreated. A failed snapshot aborts the upgrade untouched.
# BACKUP_BASE_URL=http://pos-backup:8300
# BACKUP_SNAPSHOT_TIMEOUT=600      # give up waiting for the backup after this (s)

# Decoupled download resilience on weak networks. Only authentication failures
# and "image does not exist" are terminal; DNS hiccups, TLS timeouts, resets,
# 5xx and rate limits are all retried with backoff.
# PULL_RETRY_MAX=4                 # attempts per image before giving up
# PULL_RETRY_BASE_DELAY=5          # first backoff delay (s); grows ×PULL_RETRY_FACTOR
# PULL_RETRY_FACTOR=3              # 5s → 15s → 45s …
# PULL_STALL_TIMEOUT=120           # kill+retry a pull that makes no progress for this long (s)
# PULL_ATTEMPT_TIMEOUT=1800        # absolute ceiling for one pull attempt (s)

# Disk hygiene — refuse to download when space is low; cap the audit log.
# MIN_FREE_DISK_BYTES=3221225472   # 3 GB free-space floor for the disk preflight
# DISK_CHECK_PATH=/var/lib/docker  # falls back to / inside the container
# AUDIT_LOG_MAX_BYTES=10485760     # 10 MB cap on the updater's own upgrades.jsonl


# Kiosk power agent — remembers whether the installer set up the local
# poweroff service (kiosk-agent/) on this machine, so a re-run pre-ticks the
# box. Set by the installer; no effect on any container. Unticking the box
# only stops future installs — removing an installed agent is a manual
# step, see kiosk-agent/README.md.
# POS_KIOSK_AGENT=false
