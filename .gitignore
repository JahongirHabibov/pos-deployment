# -- Secrets & generated environment files --
.env
.env.backup
*.env.backup
# pos-updater rewrites .env in place and leaves .env.bak-<epoch> next to it.
# Those copies hold every secret the original does, so they must never be
# committable in a public repository.
.env.bak-*
.env.bak
*.env.bak*

# -- Python cache --
__pycache__/
*.py[cod]
*.pyo

# -- OS / editor artefacts --
.DS_Store
Thumbs.db
*.swp
*.swo

# -- Custom --
tmp-*
logs/
updater-state/
backups/
log-*
data/*

# -- Remote Access --
remote-access.conf