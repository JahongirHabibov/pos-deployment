<?xml version="1.0" encoding="UTF-8"?>
<!-- Openbox for the POS kiosk session: no menus, no window decorations and
     only the key bindings listed here (no Alt+Tab, no desktop switching). -->
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <focus>
    <focusNew>yes</focusNew>
    <followMouse>no</followMouse>
  </focus>
  <desktops>
    <number>1</number>
  </desktops>
  <keyboard>
    <!-- Ctrl+Alt+Shift+A: login screen for the administrator (the kiosk keeps running) -->
    <keybind key="C-A-S-a">
      <action name="Execute"><command>dm-tool switch-to-greeter</command></action>
    </keybind>
    <!-- Ctrl+Alt+Shift+R: restart the kiosk browser -->
    <keybind key="C-A-S-r">
      <action name="Execute"><command>systemctl --user restart pos-kiosk-browser.service</command></action>
    </keybind>
  </keyboard>
  <mouse>
    <dragThreshold>8</dragThreshold>
  </mouse>
  <applications>
    <application class="*">
      <decor>no</decor>
      <maximized>true</maximized>
    </application>
  </applications>
</openbox_config>
